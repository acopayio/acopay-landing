# Always revalidate HTML after each deploy
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/site.webmanifest
  Cache-Control: public, max-age=86400

# Vite hashed build assets
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Brand assets
/assets/logo.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/assets/logo-solid.png
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/assets/logo-512.png
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/assets/favicon.png
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/assets/title-icon-128.png
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/assets/logo-circle.png
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/assets/favicon-title-512.png
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

# Language flag icons
/assets/flags/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

# Social preview image — unique filename + short TTL (Telegram caches hard)
/assets/og-card.png
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

/assets/og-image.png
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

# Other public assets default
/assets/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
